# Porta HTTP
PORT=3000
# Connessione MySQL (mysql2)
DATABASE_URL=mysql://sourcingdesk:sourcingdesk@127.0.0.1:3306/sourcingdesk
# Durata sessione in ore
SESSION_TTL_HOURS=168
# Impostare true dietro HTTPS (cookie Secure)
COOKIE_SECURE=false
# true dietro un reverse proxy/tunnel: usa cf-connecting-ip / x-forwarded-for per il rate limit
TRUST_PROXY=false
# Valutazione AI opzionale (API compatibile OpenAI). Senza chiave si usa una valutazione euristica locale.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
# Robot: timeout fetch, dimensione massima pagina, limite esecuzioni
ROBOT_TIMEOUT_MS=10000
ROBOT_MAX_BYTES=2000000
ROBOT_RATE_LIMIT=5
ROBOT_RATE_WINDOW_MS=60000
# Solo per test locali: consente al robot di leggere host privati (NON usare in produzione)
ALLOW_PRIVATE_FETCH=false
